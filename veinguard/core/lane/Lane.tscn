[sub_resource type="Shader" id="Shader_blend"]
code = "shader_type canvas_item;
uniform float threshold : hint_range(0.0, 1.0) = 0.12;
uniform float softness : hint_range(0.0, 1.0) = 0.08;
void fragment() {
	vec4 col = texture(TEXTURE, UV);
	float dist = length(col.rgb);
	float alpha = smoothstep(threshold, threshold + softness, dist);
	col.a *= alpha;
	COLOR = col;
}"

